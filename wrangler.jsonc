{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "agent-arena",
  "main": "cloudflare/worker.mjs",
  "compatibility_date": "2026-11-05",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/mcp", "/mcp/*"]
  },
  "durable_objects": {
    "bindings": [{"name": "ARENA", "class_name": "ArenaCoordinator"}]
  },
  "migrations": [{"tag": "v1", "new_sqlite_classes": ["ArenaCoordinator"]}],
  "observability": {"enabled": false}
}
